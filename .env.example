# Cloudflare API token with the "Edit Cloudflare Workers" permission template.
CLOUDFLARE_API_TOKEN=

# Optional: set this when the token can access more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Telegram bot token used to publish headlines to a channel.
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel id to publish headlines to.
TELEGRAM_CHAT_ID=

# Set to true to enable Telegram publishing.
TELEGRAM_ENABLED=false

# Base URL for locally downloaded feeds in development.
# When set, feed URLs are rewritten to <LOCAL_FEEDS_URL>/<feed-id>.xml.
# docker-compose sets this to http://feeds:8080 by default for local dev.
LOCAL_FEEDS_URL=

# Maximum number of items to keep from each feed (default: 10).
FEED_ITEM_LIMIT=10

# AI scoring provider: "google" (default) or "openrouter".
AI_PROVIDER=google

# Gemini API key used when AI_PROVIDER=google.
GEMINI_API_KEY=

# Gemini model used for scoring, e.g. gemini-2.5-flash.
GEMINI_MODEL=

# OpenRouter API key used when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# OpenRouter model used when AI_PROVIDER=openrouter.
OPENROUTER_MODEL=

# Number of items to score per AI request (default: 20).
AI_SCORE_BATCH_SIZE=20

# Bluesky handle (e.g. user.bsky.social) used to publish headlines.
BSKY_HANDLE=

# Bluesky app password used to publish headlines to the account.
BSKY_APP_PASSWORD=

# Set to true to enable Bluesky publishing.
BSKY_ENABLED=false


