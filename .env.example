# Cloudflare API token with the "Edit Cloudflare Workers" permission template.
CLOUDFLARE_API_TOKEN=

# Optional: set this when the token can access more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Telegram bot token used to publish headlines to a channel.
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel id to publish headlines to.
TELEGRAM_CHAT_ID=

# Set to true to enable Telegram publishing.
TELEGRAM_ENABLED=false

# Bluesky handle (e.g. user.bsky.social) used to publish headlines.
BSKY_HANDLE=

# Bluesky app password used to publish headlines to the account.
BSKY_APP_PASSWORD=

# Set to true to enable Bluesky publishing.
BSKY_ENABLED=false

# Search provider: "gemini" (default) or "openrouter".
SEARCH_PROVIDER=gemini

# Gemini API key used to search the web and score the latest news.
GEMINI_API_KEY=

# Gemini model used for the web search. Grounding with Google Search must be supported.
GEMINI_MODEL=gemini-3.6-flash

# Optional override for the Gemini API base URL.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenRouter API key used when SEARCH_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# OpenRouter model used when SEARCH_PROVIDER=openrouter.
OPENROUTER_MODEL=perplexity/sonar

# Optional override for the OpenRouter API base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# How many articles to request on each ingestion.
NEWS_ITEM_COUNT=20
