# Cloudflare API token with the "Edit Cloudflare Workers" permission template.
CLOUDFLARE_API_TOKEN=

# Optional: set this when the token can access more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Telegram bot token used to publish headlines to a channel.
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel id to publish headlines to.
TELEGRAM_CHAT_ID=
