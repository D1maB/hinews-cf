#!/bin/sh
# Runs the Compose CLI available on this machine, preferring the standalone
# `docker-compose` binary and falling back to the `docker compose` plugin.
# Always uses the root docker-compose.yml and loads secrets from .env.
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
COMPOSE_FILE="$PROJECT_DIR/docker-compose.yml"
ENV_FILE="$PROJECT_DIR/.env"

set -- -f "$COMPOSE_FILE" "$@"
if [ -f "$ENV_FILE" ]; then
  set -- --env-file "$ENV_FILE" "$@"
fi

if command -v docker-compose >/dev/null 2>&1; then
  exec docker-compose "$@"
fi

exec docker compose "$@"
