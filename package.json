{
  "name": "hinews-cf",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Cloudflare Worker that says Hello World",
  "type": "module",
  "scripts": {
    "dev": "docker-compose up --build dev",
    "test": "docker-compose run --rm test",
    "deploy": "docker-compose run --rm deploy",
    "dev:worker": "wrangler dev",
    "test:unit": "node --test",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^3.114.17"
  }
}
