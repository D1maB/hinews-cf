{
  "name": "hinews-cf",
  "version": "0.1.0",
  "private": true,
  "description": "A Cloudflare Worker that fetches, stores, and publishes PC hardware news from RSS feeds",
  "type": "module",
  "scripts": {
    "dev": "docker-compose up -d --build app",
    "test": "docker-compose run --rm test",
    "typecheck": "docker-compose run --rm tools npx tsc --noEmit",
    "lint": "docker-compose run --rm tools npx eslint .",
    "format": "docker-compose run --rm tools npx prettier --write .",
    "format:check": "docker-compose run --rm tools npx prettier --check .",
    "qa": "docker-compose run --rm tools sh -c \"npx prettier --check . && npx eslint . && npx tsc --noEmit && npx tsx --test\"",
    "deploy": "docker-compose run --rm deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1"
  }
}
